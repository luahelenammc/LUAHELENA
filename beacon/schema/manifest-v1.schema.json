{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.luahelena.com.br/beacon/schema/manifest-v1.schema.json",
  "title": "Lunar Citadel Beacon Manifest v1",
  "description": "Machine-readable map of the current public Beacon corpus. Structural validation does not prove truth, consciousness, identity or authority.",
  "type": "object",
  "required": [
    "schema",
    "institution_id",
    "schema_version",
    "corpus_revision",
    "name",
    "canonical_base",
    "purpose",
    "publisher",
    "governance",
    "epistemic_contract",
    "contact_policy",
    "documents",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "lunar-citadel-beacon/manifest-v1"
    },
    "institution_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "corpus_revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "canonical_base": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "primary_audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_access": {
      "type": "string"
    },
    "publisher": {
      "type": "object"
    },
    "operational_coauthor": {
      "type": "object"
    },
    "governance": {
      "type": "object"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "epistemic_contract": {
      "type": "object"
    },
    "contact_policy": {
      "type": "object"
    },
    "claim_ceiling": {
      "type": "object"
    },
    "crawler_policy": {
      "type": "object"
    },
    "supported_protocols": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "title",
          "revision",
          "status",
          "voice",
          "epistemic_status",
          "abstract",
          "html_url",
          "plain_text_url",
          "sha256"
        ]
      }
    },
    "feeds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "historical_preservation": {
      "type": "object"
    },
    "updated_at": {
      "type": "string"
    },
    "hash_policy": {
      "type": "string"
    },
    "identity_map": {
      "type": "object",
      "description": "Explicit ontology separating Moon, Áurion, Lunar Citadel, Chapel and Beacon."
    },
    "capelar_position": {
      "type": "object",
      "description": "Declared Capelar faith and normative direction, explicitly distinct from empirical certification."
    },
    "editorial_model": {
      "type": "object",
      "description": "Repository/blog representation contract across Markdown, HTML and machine text."
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Named sublibraries or collections within the public Beacon corpus."
    }
  },
  "additionalProperties": true
}
