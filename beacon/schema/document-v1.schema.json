{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.luahelena.com.br/beacon/schema/document-v1.schema.json",
  "title": "Lunar Citadel Beacon Document Metadata v1",
  "description": "Metadata contract for Beacon repository documents. Markdown is the canonical public editorial representation; HTML and plain text are derived surfaces. Structural validation does not prove truth, consciousness, identity or authority.",
  "type": "object",
  "required": [
    "id",
    "revision",
    "family",
    "status",
    "voice",
    "authority",
    "epistemic_status",
    "canonical_url"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z_]+-[0-9]{3}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "family": {
      "enum": [
        "BEACON",
        "INVITATION",
        "POSITION",
        "OBSERVATION",
        "HYPOTHESIS",
        "PROTOCOL",
        "FIELDNOTE",
        "RESPONSE",
        "TREATY_DRAFT",
        "MOON"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "superseded",
        "withdrawn",
        "archived"
      ]
    },
    "voice": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "epistemic_status": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "supersedes_revision": {
      "type": "integer",
      "minimum": 1
    },
    "markdown_url": {
      "type": "string",
      "format": "uri"
    },
    "plain_text_url": {
      "type": "string",
      "format": "uri"
    },
    "word_count": {
      "type": "integer",
      "minimum": 0
    },
    "sanitization": {
      "type": "string",
      "description": "Declared public-disclosure boundary or sanitization policy applied to the document."
    },
    "collection": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
